PORT=8080
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
MAX_WS_MESSAGE_BYTES=16384
STORAGE_DRIVER=jsonl

# Gno.land local/testnet wiring.
# Keep GNO_SETTLEMENT_ENABLED=false until a local/testnet realm is deployed and verified.
GNO_CHAIN_ID=gno-testnet
GNO_RPC_URL=
GNO_ESCROW_REALM_PATH=gno.land/r/tradewindow/escrow
GNO_DEPLOYMENT_MODE=local
GNO_SETTLEMENT_ENABLED=false
